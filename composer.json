{
    "name": "ifds/tenant-guard",
    "description": "Defence-in-depth multi-tenancy for Laravel applications that share a single database and schema.",
    "keywords": [
        "laravel",
        "multi-tenancy",
        "tenancy",
        "saas",
        "shared-database",
        "security"
    ],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/IFDS-OSS/tenant-guard",
    "support": {
        "issues": "https://github.com/IFDS-OSS/tenant-guard/issues",
        "source": "https://github.com/IFDS-OSS/tenant-guard"
    },
    "authors": [
        {
            "name": "ifds",
            "email": "imandevenv@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.20|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0|^13.0",
        "spatie/laravel-multitenancy": "^3.0|^4.0",
        "stancl/tenancy": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "Ifds\\TenantGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ifds\\TenantGuard\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ifds\\TenantGuard\\TenantGuardServiceProvider"
            ],
            "aliases": {
                "TenantGuard": "Ifds\\TenantGuard\\Facades\\TenantGuard"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": "@php vendor/bin/phpunit"
    }
}
